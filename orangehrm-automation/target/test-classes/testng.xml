<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    ============================================================
    OrangeHRM Automation Test Suite - TestNG Configuration
    ============================================================
    Cách chạy:
      mvn test                          (chạy toàn bộ)
      mvn test -Dgroups=smoke           (chỉ smoke test)
      mvn test -Dgroups=regression      (regression test)
      mvn test -Dtest=LoginTest         (chỉ chạy 1 class)
    ============================================================
-->

<suite name="OrangeHRM Automation Suite" verbose="2" parallel="false">

    <!-- ==================== SMOKE TESTS ==================== -->
    <test name="Smoke Tests - Kiểm thử nhanh" >
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.orangehrm.tests.LoginTest"/>
            <class name="com.orangehrm.tests.DashboardTest"/>
            <class name="com.orangehrm.tests.EmployeeTest"/>
            <class name="com.orangehrm.tests.AdminTest"/>
            <class name="com.orangehrm.tests.LeaveTest"/>
        </classes>
    </test>

    <!-- ==================== REGRESSION TESTS ==================== -->
    <test name="Regression Tests - Kiểm thử hồi quy">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.orangehrm.tests.LoginTest"/>
            <class name="com.orangehrm.tests.DashboardTest"/>
            <class name="com.orangehrm.tests.EmployeeTest"/>
            <class name="com.orangehrm.tests.AdminTest"/>
            <class name="com.orangehrm.tests.LeaveTest"/>
        </classes>
    </test>

</suite>
